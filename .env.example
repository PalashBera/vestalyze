# API backend: mock | supabase
API_PROVIDER=mock

# Demo login is seeded only when both values are set in a local env file.
# Used by the mock provider only. Copy this file to .env.local (gitignored).
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Optional. A CSPRNG value is generated in-memory when unset (mock sessions).
SESSION_SECRET=

# Supabase (used when API_PROVIDER=supabase)
# Project Settings → API. Server-side only. Never commit the service role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
