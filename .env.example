SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend — contact form delivery. Server-only; never expose as NEXT_PUBLIC_*.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend for the visitor
# acknowledgement to deliver. Defaults to Resend's sandbox sender, which can
# only reach the address that owns the Resend account.
CONTACT_FROM_EMAIL=
# Inbox that receives contact requests.
CONTACT_TO_EMAIL=
